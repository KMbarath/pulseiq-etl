
RAW_DIR=data/raw
CLEAN_DIR=data/clean
REJECTED_DIR=data/rejected
LOG_DIR=logs

# Fixed date makes tenure calculations reproducible.
ETL_AS_OF_DATE=2026-10-12

# Invalid rows are always quarantined in data/rejected. Keep this true so the
# command also fails loudly and downstream jobs cannot consume partial data.
FAIL_ON_REJECTS=true
